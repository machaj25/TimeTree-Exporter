# Copy to .env (ignored by git) and fill in. Used by compose.yaml.

# Sign in with email and password ...
TIMETREE_EMAIL=you@example.com
TIMETREE_PASSWORD=change-me

# ... or reuse the _session_id cookie from a browser session instead
# (leave the password empty when you set this).
#TIMETREE_SESSION_ID=

# Calendar code(s) to export, comma-separated. Find them in the TimeTree URL
# or by running the tool once without -c.
TIMETREE_CALENDAR_CODE=your_calendar_code
